local setTarget

local function refreshPlayerList()
    for _, child in ipairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for _, plr in ipairs(getValidPlayers()) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 30)
        btn.BackgroundColor3 = (State.targetPlayer == plr) and Color3.fromRGB(100, 50, 200) or Color3.fromRGB(40, 40, 50)
        btn.Text = plr.DisplayName
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        btn.Parent = playerListFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            if State.active then
                setTarget(plr)
                -- Highlight selected player
                for _, child in ipairs(playerListFrame:GetChildren()) do
                    if child:IsA("TextButton") then
                        child.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                    end
                end
                btn.BackgroundColor3 = Color3.fromRGB(100, 50, 200)
            end
        end)
    end
end

setTarget = function(plr)
    if not State.active then return end
    if not plr or plr == LocalPlayer then return end
    if not plr.Character then return end
    
    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Disconnect previous target's CharacterAdded
    if State.targetConn then
        State.targetConn:Disconnect()
        State.targetConn = nil
    end
    
    State.targetPlayer = plr
    State.targetChar = plr.Character
    State.targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
    State.targetHead = plr.Character:FindFirstChild("Head")
    
    targetNameLabel.Text = plr.DisplayName
    
    -- Listen for respawns of this specific target
    State.targetConn = plr.CharacterAdded:Connect(function(newChar)
        if State.active and State.targetPlayer == plr then
            State.targetChar = newChar
            State.targetRoot = newChar:FindFirstChild("HumanoidRootPart")
            State.targetHead = newChar:FindFirstChild("Head")
        end
    end)
end

local function stopSpectating()
    if not State.active then return end
    State.active = false
    
    disconnectAll()
    if State.cameraConn then
        RunService:UnbindFromRenderStep("SpectatorCamera")
        State.cameraConn = nil
    end
    disableBlur()
    
    mainFrame.Visible = true
    playerListContainer.Visible = true
    toggleMainBtn.Text = "ENABLE SPECTATOR"
    
    -- Restore camera
    if Camera.CameraType == Enum.CameraType.Scriptable then
        Camera.CameraType = State.lastCameraType or Enum.CameraType.Custom
        if State.lastCameraSubject then
            Camera.CameraSubject = State.lastCameraSubject
        elseif LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then Camera.CameraSubject = hum end
        end
    end
    
    State.targetPlayer = nil
    State.targetChar = nil
    State.targetRoot = nil
    State.targetHead = nil
    targetNameLabel.Text = "None"
end

local function startSpectating()
    if State.active then return end
    State.active = true
    State.lastCameraType = Camera.CameraType
    State.lastCameraSubject = Camera.CameraSubject
    
    Camera.CameraType = Enum.CameraType.Scriptable
    
    -- Clean up any existing camera binding
    RunService:UnbindFromRenderStep("SpectatorCamera")
    State.cameraConn = RunService:BindToRenderStep(
        "SpectatorCamera",
        Enum.RenderPriority.Camera.Value + 1,
        function(dt)
            updateCamera(dt)
        end
    )
    
    enableBlur()
    mainFrame.Visible = true
    playerListContainer.Visible = true
    toggleMainBtn.Text = "DISABLE SPECTATOR"
    
    refreshPlayerList()
    
    -- Do NOT auto-select. Leave target null until user clicks a player.
    State.targetPlayer = nil
    State.targetChar = nil
    State.targetRoot = nil
    State.targetHead = nil
    targetNameLabel.Text = "Select a player..."
    
    -- Input handling
    addConnection(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or not State.active then return end
        
        if input.KeyCode == Enum.KeyCode.LeftBracket then
            local players = getValidPlayers()
            if #players > 0 then
                local idx = table.find(players, State.targetPlayer) or 1
                idx = idx - 1
                if idx < 1 then idx = #players end
                setTarget(players[idx])
                refreshPlayerList()
            end
        elseif input.KeyCode == Enum.KeyCode.RightBracket then
            local players = getValidPlayers()
            if #players > 0 then
                local idx = table.find(players, State.targetPlayer) or 0
                idx = idx + 1
                if idx > #players then idx = 1 end
                setTarget(players[idx])
                refreshPlayerList()
            end
        elseif input.KeyCode == Enum.KeyCode.P then
            stopSpectating()
        end
    end))
    
    -- Handle players leaving
    addConnection(Players.PlayerRemoving:Connect(function(plr)
        if State.active and State.targetPlayer == plr then
            local valid = getValidPlayers()
            if #valid > 0 then
                setTarget(valid[1])
            else
                stopSpectating()
            end
        end
        refreshPlayerList()
    end))
    
    -- Handle players joining
    addConnection(Players.PlayerAdded:Connect(function(plr)
        refreshPlayerList()
    end))
end

toggleMainBtn.MouseButton1Click:Connect(function()
    if State.active then
        stopSpectating()
    else
        startSpectating()
    end
end)

refreshBtn.MouseButton1Click:Connect(function()
    refreshPlayerList()
end)

