end

local function getValidPlayers()
    local valid = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            table.insert(valid, plr)
        end
    end
    return valid
end

-- ============================================================================
-- CAMERA MATH & LOGIC
-- ============================================================================
local function smoothLerp(current, target, dt, speed)
    local alpha = 1 - math.exp(-speed * dt)
    return current:Lerp(target, alpha)
end

local function calculateCameraPosition(mode, root, head, distance, height, offset)
    local rootCFrame = root.CFrame
    local headCFrame = head.CFrame
    local lookVec = rootCFrame.LookVector
    
    if mode == "FirstPerson" then
        return headCFrame * CFrame.new(0, 0.5, -0.5)
    elseif mode == "ThirdPerson" then
        return CFrame.lookAt(
            rootCFrame.Position + Vector3.new(0, height, 0) - lookVec * distance,
            rootCFrame.Position + Vector3.new(0, height, 0)
        )
    elseif mode == "FaceLock" then
        return CFrame.lookAt(
            headCFrame.Position + lookVec * distance,
            headCFrame.Position
        )
    elseif mode == "Cinematic" then
        local rightVec = rootCFrame.RightVector
        return CFrame.lookAt(
            rootCFrame.Position + lookVec * distance + rightVec * offset + Vector3.new(0, height, 0),
            rootCFrame.Position + Vector3.new(0, height, 0)
        )
    end
    return rootCFrame
end

local function updateCamera(dt)
    if not State.targetChar or not State.targetRoot or not State.targetHead then return end
    if not State.targetRoot.Parent or not State.targetHead.Parent then return end
    
    local humanoid = State.targetChar:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local mode = Settings.cameraMode
    local distance = Settings.zoomDistance
    local height = Settings.cameraHeight
    local offset = Settings.cameraOffset
    
    local desiredCFrame = calculateCameraPosition(mode, State.targetRoot, State.targetHead, distance, height, offset)
    
    -- Collision prevention
    if mode ~= "FirstPerson" then
        local rayOrigin = State.targetHead.Position
        local rayDir = desiredCFrame.Position - rayOrigin
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {State.targetChar, Camera}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local result = Workspace:Raycast(rayOrigin, rayDir, rayParams)
        if result then
            local hitDistance = (result.Position - rayOrigin).Magnitude
            local maxAllowed = math.max(0.5, hitDistance - 0.5)
            local dir = rayDir.Unit
            desiredCFrame = CFrame.lookAt(rayOrigin + dir * maxAllowed, rayOrigin)
        end
    end
    
    -- Smoothing with frame-independent interpolation
    local posSpeed = Settings.positionSmoothness * 10
    local rotSpeed = Settings.rotationSmoothness * 10
    
    local currentPos = Camera.CFrame.Position
    local currentRot = Camera.CFrame.Rotation
    
    local newPos = smoothLerp(currentPos, desiredCFrame.Position, dt, posSpeed)
    local newRot = currentRot:Lerp(desiredCFrame.Rotation, 1 - math.exp(-rotSpeed * dt))
    
    Camera.CFrame = CFrame.new(newPos) * newRot
    Camera.FieldOfView = Camera.FieldOfView + (Settings.fov - Camera.FieldOfView) * (1 - math.exp(-5 * dt))
end

-- ============================================================================
-- MOTION BLUR
-- ============================================================================
local function createBlur()
    if State.blurEffect then return end
    State.blurEffect = Instance.new("BlurEffect")
    State.blurEffect.Name = "SpectatorMotionBlur"
    State.blurEffect.Size = 0
    State.blurEffect.Parent = Lighting
end

local function destroyBlur()
    if State.blurEffect then
        State.blurEffect:Destroy()
        State.blurEffect = nil
    end
end

local function updateBlur(dt)
    if not Settings.motionBlurEnabled or not State.blurEffect then
        if State.blurEffect then State.blurEffect.Size = 0 end
        return
    end
    
    local currentCFrame = Camera.CFrame
    
    if State.lastCameraCFrame then
        local look1 = State.lastCameraCFrame.LookVector
        local look2 = currentCFrame.LookVector
        local dot = look1:Dot(look2)
        local angle = math.acos(math.clamp(dot, -1, 1))
        
        local intensity = Settings.blurIntensity * 10
        local maxBlur = 15
        local targetBlur = math.min(angle * intensity / math.max(dt, 0.001) * Settings.blurResponsiveness, maxBlur)
        
        State.accumulatedBlur = State.accumulatedBlur + (targetBlur - State.accumulatedBlur) * (1 - math.exp(-10 * dt))
        State.blurEffect.Size = math.max(0, State.accumulatedBlur)
    end
    
    State.lastCameraCFrame = currentCFrame
end

local function enableBlur()
    createBlur()
    if State.blurConn then State.blurConn:Disconnect() end
    State.blurConn = RunService.RenderStepped:Connect(updateBlur)
end

local function disableBlur()
    if State.blurConn then
        State.blurConn:Disconnect()
        State.blurConn = nil
    end
    destroyBlur()
    State.accumulatedBlur = 0
    State.lastCameraCFrame = nil
end

