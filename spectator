    toggleBtn.Size = UDim2.new(0.2, 0, 0, 24)
    toggleBtn.Position = UDim2.new(0.75, 0, 0.5, -12)
    toggleBtn.BackgroundColor3 = initialState and Color3.fromRGB(100, 50, 200) or Color3.fromRGB(60, 60, 60)
    toggleBtn.Text = initialState and "ON" or "OFF"
    toggleBtn.TextColor3 = Color3.new(1, 1, 1)
